3)AFTER INSERT ON points

Recalculate and update cityzen.points total

CREATE TRIGGER after_insert_points
AFTER INSERT ON points
FOR EACH ROW
BEGIN
    -- Recalculate and update total points for the user
    DECLARE total_points INT;
    
    -- Get total points for the user
    SELECT SUM(points) INTO total_points
    FROM points
    WHERE user_id = NEW.user_id;
    
    -- Update the total points for the user
    UPDATE cityzen
    SET points = total_points
    WHERE user_id = NEW.user_id;
END;



