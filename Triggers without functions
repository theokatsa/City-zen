1)AFTER UPDATE ON reports.status

If status = "Completed":

Notify user

Award points

If status = "Rejected"/"False Report":

Notify user

Deduct points

CREATE TRIGGER after_update_report_status
AFTER UPDATE ON reports
FOR EACH ROW
BEGIN
    -- Notify user if status is "Completed"
    IF NEW.status = 'Completed' THEN
        -- Assuming a `notify_user` function or insert statement to notify the user
        CALL notify_user(NEW.user_id, 'Your report has been completed.');
        
        -- Award points
        UPDATE points
        SET points = points + 10 -- Adjust the points increment value as needed
        WHERE user_id = NEW.user_id;
        
    -- Notify user if status is "Rejected" or "False Report"
    ELSEIF NEW.status IN ('Rejected', 'False Report') THEN
        -- Assuming a `notify_user` function or insert statement to notify the user
        CALL notify_user(NEW.user_id, 'Your report has been rejected or marked as false.');
        
        -- Deduct points
        UPDATE points
        SET points = points - 5 -- Adjust the points deduction value as needed
        WHERE user_id = NEW.user_id;
    END IF;
END;


