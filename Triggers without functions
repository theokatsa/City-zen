5)AFTER INSERT ON ai_chat

Log message

If feedback rating exists, update satisfaction stats

CREATE TRIGGER after_insert_ai_chat
AFTER INSERT ON ai_chat
FOR EACH ROW
BEGIN
    -- Log message to chat logs
    INSERT INTO chat_logs (user_id, message) 
    VALUES (NEW.user_id, NEW.message);

    -- If feedback exists, update satisfaction stats
    IF NEW.feedback_rating IS NOT NULL THEN
        UPDATE satisfaction_stats
        SET average_rating = (SELECT AVG(feedback_rating) FROM ai_chat WHERE user_id = NEW.user_id)
        WHERE user_id = NEW.user_id;
    END IF;
END;

