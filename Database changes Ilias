-- UPDATED AT 
-- USERS: Track profile or password changes
ALTER TABLE users
ADD COLUMN updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP;

-- CITYZEN: Track point or profile activity
ALTER TABLE cityzen
ADD COLUMN updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP;

-- REPORTS: Monitor updates like status, priority, etc.
ALTER TABLE reports
ADD COLUMN updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP;

-- NOTIFICATIONS: Optional — track read status changes or edits
ALTER TABLE notifications
ADD COLUMN updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP;

-- MUNICIPALITY_POST: Optional — if posts are editable
ALTER TABLE municipality_post
ADD COLUMN updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP;

-- CITYZEN_COMMENT: Optional — if comment editing is allowed
ALTER TABLE cityzen_comment
ADD COLUMN updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP;
