-- Table for Notifications
CREATE TABLE notifications (
    id INT AUTO_INCREMENT PRIMARY KEY,
    user_id INT NOT NULL,
    message TEXT NOT NULL,
    is_read BOOLEAN DEFAULT FALSE,
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    action_type ENUM(
        'report_submitted',
        'status_updated',
        'points_awarded',
        'points_deducted',
        'admin_announcement',
        'general'
    ) NOT NULL,
    report_id INT DEFAULT NULL,
    FOREIGN KEY (user_id) REFERENCES users(id),
    FOREIGN KEY (report_id) REFERENCES reports(id)
);

-- Table for Requests
CREATE TABLE requests (
    id INT AUTO_INCREMENT PRIMARY KEY,
    cityzen_id INT NOT NULL,
    municipality_id INT NOT NULL,
    description TEXT NOT NULL,
    status ENUM('Pending', 'Approved', 'Rejected') NOT NULL,
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
    FOREIGN KEY (cityzen_id) REFERENCES cityzen(id),
    FOREIGN KEY (municipality_id) REFERENCES municipality(id)
);

-- Table for cityzen Comments
CREATE TABLE cityzen_comment (
    id INT AUTO_INCREMENT PRIMARY KEY,
    report_id INT NOT NULL,
    cityzen_id INT NOT NULL,
    comment TEXT NOT NULL,
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    FOREIGN KEY (report_id) REFERENCES reports(id),
    FOREIGN KEY (cityzen_id) REFERENCES cityzen(id)
);

-- Table for Points (Awarded/Deducted Points)
CREATE TABLE points (
    id INT AUTO_INCREMENT PRIMARY KEY,
    user_id INT NOT NULL,
    report_id INT DEFAULT NULL, -- NULL if points not related to a specific report
    points_awarded INT NOT NULL,
    reason VARCHAR(255) NOT NULL,
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    FOREIGN KEY (user_id) REFERENCES users(id),
    FOREIGN KEY (report_id) REFERENCES reports(id)
);

