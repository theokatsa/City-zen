-- Table for Users
CREATE TABLE users (
    id INT AUTO_INCREMENT PRIMARY KEY,
    username VARCHAR(100) NOT NULL,
    email VARCHAR(100) NOT NULL UNIQUE,
    password_hash VARCHAR(255) NOT NULL,
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

-- Table for citizens
CREATE TABLE cityzen (
    id INT AUTO_INCREMENT PRIMARY KEY,
    user_id INT NOT NULL,
    points INT DEFAULT 0,
    FOREIGN KEY (user_id) REFERENCES users(id)
);

-- Table for Municipality/Public Authorities
CREATE TABLE municipality (
    id INT AUTO_INCREMENT PRIMARY KEY,
    name VARCHAR(100) NOT NULL,
    contact_email VARCHAR(100),
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

-- Table for Location
CREATE TABLE location (
    id INT AUTO_INCREMENT PRIMARY KEY,
    latitude DOUBLE NOT NULL,
    longitude DOUBLE NOT NULL,
    address VARCHAR(255) NOT NULL
);

-- Table for Reports
CREATE TABLE reports (
    id INT AUTO_INCREMENT PRIMARY KEY,
    cityzen_id INT NOT NULL,
    location_id INT NOT NULL,
    category ENUM('lighting', 'roadworks', 'other') NOT NULL DEFAULT 'other',
    description TEXT NOT NULL,
    priority ENUM('High', 'Medium', 'Low') NOT NULL DEFAULT 'medium',
    status ENUM('Pending', 'In Progress', 'Completed') NOT NULL DEFAULT 'Pending',
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    FOREIGN KEY (cityzen_id) REFERENCES cityzen(id),
    FOREIGN KEY (location_id) REFERENCES location(id)
);

-- Table for Municipality Announcements
CREATE TABLE municipality_post (
    id INT AUTO_INCREMENT PRIMARY KEY,
    municipality_id INT NOT NULL,
    title VARCHAR(255) NOT NULL,
    content TEXT NOT NULL,
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    FOREIGN KEY (municipality_id) REFERENCES municipality(id)
);

-- Table for AI Chat
CREATE TABLE ai_chat (
    id INT AUTO_INCREMENT PRIMARY KEY,
    cityzen_id INT NOT NULL,
    message TEXT NOT NULL,
    is_user BOOLEAN NOT NULL,  -- TRUE = user, FALSE = AI
    report_id INT,             -- Optional: linked to a report
    action_type ENUM('submit_report', 'check_status', 'get_info', 'feedback', 'other'),
    feedback_rating TINYINT,   -- 1 to 5
    user_feedback TEXT,        -- Optional comment
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    FOREIGN KEY (conversation_id) REFERENCES ai_conversation(id) ON DELETE CASCADE,
    FOREIGN KEY (cityzen_id) REFERENCES cityzen(id),
    FOREIGN KEY (report_id) REFERENCES report(id)
);


-- Table for Notifications
CREATE TABLE notifications (
    id INT AUTO_INCREMENT PRIMARY KEY,
    user_id INT NOT NULL,
    message TEXT NOT NULL,
    is_read BOOLEAN DEFAULT FALSE,
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    action_type ENUM(
        'report_submitted',
        'status_updated',
        'points_awarded',
        'points_deducted',
        'admin_announcement',
        'general'
    ) NOT NULL,
    report_id INT DEFAULT NULL,
    FOREIGN KEY (user_id) REFERENCES users(id),
    FOREIGN KEY (report_id) REFERENCES reports(id)
);

-- Table for Requests
CREATE TABLE requests (
    id INT AUTO_INCREMENT PRIMARY KEY,
    cityzen_id INT NOT NULL,
    municipality_id INT NOT NULL,
    description TEXT NOT NULL,
    status ENUM('Pending', 'Approved', 'Rejected') NOT NULL,
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
    FOREIGN KEY (cityzen_id) REFERENCES cityzen(id),
    FOREIGN KEY (municipality_id) REFERENCES municipality(id)
);

-- Table for cityzen Comments
CREATE TABLE cityzen_comment (
    id INT AUTO_INCREMENT PRIMARY KEY,
    report_id INT NOT NULL,
    cityzen_id INT NOT NULL,
    comment TEXT NOT NULL,
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    FOREIGN KEY (report_id) REFERENCES reports(id),
    FOREIGN KEY (cityzen_id) REFERENCES cityzen(id)
);

-- Table for Points (Awarded/Deducted Points)
CREATE TABLE points (
    id INT AUTO_INCREMENT PRIMARY KEY,
    user_id INT NOT NULL,
    report_id INT DEFAULT NULL, -- NULL if points not related to a specific report
    points_awarded INT NOT NULL,
    reason VARCHAR(255) NOT NULL,
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    FOREIGN KEY (user_id) REFERENCES users(id),
    FOREIGN KEY (report_id) REFERENCES reports(id)
);

